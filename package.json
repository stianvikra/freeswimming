{
  "name": "freeswimming",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.17.0 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/sanitize-next-build-artifacts.mjs && next build",
    "build:webpack": "node ./scripts/sanitize-next-build-artifacts.mjs && next build --webpack",
    "start": "next start",
    "prepare": "husky",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:briefs": "node ./scripts/lint-task-brief-scorecard.mjs",
    "lint:briefs:all": "node ./scripts/lint-task-brief-scorecard.mjs --all",
    "lint:admin-audit": "node ./scripts/lint-admin-audit-checklist.mjs",
    "lint:env-parity": "node ./scripts/lint-env-parity-bundle.mjs",
    "lint:pr-body:generated": "node ./scripts/lint-generated-pr-body.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/contact-api-security.spec.ts tests/e2e/sitemap.spec.ts tests/e2e/soft-launch-banner.spec.ts tests/e2e/mobile-nav.spec.ts tests/e2e/course-nav-contextual.spec.ts --project=mobile-chromium --project=desktop-chromium",
    "test:e2e:site-lock": "SITE_LOCK_ENABLED=1 PW_PORT=3101 NEXT_DIST_DIR=.next-playwright-lock playwright test tests/e2e/private-access-gate.spec.ts --project=mobile-chromium --project=desktop-chromium",
    "test:e2e:private-gate": "npm run test:e2e:site-lock",
    "test:e2e:admin": "playwright test tests/e2e/admin-foundation.spec.ts tests/e2e/admin-content-api-guards.spec.ts tests/e2e/admin-content-parity.spec.ts tests/e2e/admin-notes-workflow.spec.ts --project=desktop-chromium",
    "test:e2e:admin:short": "bash ./scripts/run-admin-short-session.sh",
    "test:e2e:security": "playwright test tests/e2e/contact-api-security.spec.ts tests/e2e/private-access-gate.spec.ts tests/e2e/admin-foundation.spec.ts tests/e2e/admin-content-parity.spec.ts tests/e2e/api-security-negative-paths.spec.ts --project=desktop-chromium",
    "test:perf:budgets": "node ./scripts/run-perf-budget-check.mjs",
    "test:perf:trend": "node ./scripts/perf-budget-trend-status.mjs",
    "test:e2e:mobile": "playwright test --project=mobile-chromium --project=mobile-iphone-13-pro-max",
    "test:e2e:extended": "playwright test --project=tablet-ipad-pro-11 --project=desktop-chromium --project=desktop-webkit --project=desktop-firefox",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "admin:notes:import-staged": "node ./scripts/import-admin-note-staged-attachment.mjs",
    "finance:reconcile": "node ./scripts/reconcile-finance-entitlements.mjs",
    "verify:open": "SITE_LOCK_ENABLED=0 npm run verify",
    "verify:public": "SITE_LOCK_ENABLED=0 npm run verify",
    "verify:docs-only": "bash ./scripts/run-verify-docs-only.sh",
    "verify:pre-pr": "bash ./scripts/run-verify-pre-pr.sh",
    "verify:pre-merge": "bash ./scripts/run-verify-pre-merge.sh",
    "verify:open:log": "bash ./scripts/run-verify-open.sh",
    "verify:last": "bash ./scripts/show-last-verify-summary.sh",
    "gate:pre-merge": "bash ./scripts/run-pre-merge-gate.sh",
    "merge:preflight": "node ./scripts/merge-preflight.mjs --summary",
    "post-merge:preflight": "node ./scripts/post-merge-preflight.mjs --summary",
    "pr:open:safari": "bash ./scripts/open-pr-safari.sh",
    "pr:create:safari": "bash ./scripts/pr-create-safari.sh",
    "screenshots:mobile": "playwright test tests/e2e/mobile-screenshots.spec.ts --project=mobile-chromium",
    "screenshots:iphone": "playwright test tests/e2e/mobile-screenshots.spec.ts --project=mobile-iphone-13-pro-max",
    "task-brief:move": "bash ./scripts/task-brief-move.sh",
    "branch-protection:apply": "bash ./scripts/apply-branch-protection.sh",
    "verify": "npm run lint:briefs && npm run lint:admin-audit && npm run lint:env-parity && npm run lint:pr-body:generated && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:perf:budgets && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.95.3",
    "@types/qrcode": "^1.5.6",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.563.0",
    "next": "16.2.4",
    "qrcode": "^1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{css,md,json,yaml,yml}": [
      "prettier --write"
    ]
  }
}
