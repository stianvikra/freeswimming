{
  "name": "freeswimming",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "start": "next start",
    "prepare": "husky",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/contact-api-security.spec.ts tests/e2e/sitemap.spec.ts tests/e2e/soft-launch-banner.spec.ts tests/e2e/mobile-nav.spec.ts tests/e2e/course-nav-contextual.spec.ts --project=mobile-chromium --project=desktop-chromium",
    "test:e2e:site-lock": "SITE_LOCK_ENABLED=1 PW_PORT=3101 NEXT_DIST_DIR=.next-playwright-lock playwright test tests/e2e/private-access-gate.spec.ts --project=mobile-chromium --project=desktop-chromium",
    "test:e2e:private-gate": "npm run test:e2e:site-lock",
    "test:e2e:admin": "playwright test tests/e2e/admin-foundation.spec.ts tests/e2e/admin-content-parity.spec.ts tests/e2e/admin-notes-workflow.spec.ts --project=desktop-chromium",
    "test:e2e:security": "playwright test tests/e2e/contact-api-security.spec.ts tests/e2e/private-access-gate.spec.ts tests/e2e/admin-foundation.spec.ts tests/e2e/admin-content-parity.spec.ts --project=desktop-chromium",
    "test:e2e:mobile": "playwright test --project=mobile-chromium --project=mobile-iphone-13-pro-max",
    "test:e2e:extended": "playwright test --project=tablet-ipad-pro-11 --project=desktop-chromium --project=desktop-webkit --project=desktop-firefox",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "verify:open": "SITE_LOCK_ENABLED=0 npm run verify",
    "verify:public": "SITE_LOCK_ENABLED=0 npm run verify",
    "verify:pre-pr": "npm run verify:public",
    "verify:pre-merge": "bash ./scripts/run-verify-pre-merge.sh",
    "verify:open:log": "bash ./scripts/run-verify-open.sh",
    "verify:last": "bash ./scripts/show-last-verify-summary.sh",
    "pr:open:safari": "bash ./scripts/open-pr-safari.sh",
    "pr:create:safari": "bash ./scripts/pr-create-safari.sh",
    "screenshots:mobile": "playwright test tests/e2e/mobile-screenshots.spec.ts --project=mobile-chromium",
    "screenshots:iphone": "playwright test tests/e2e/mobile-screenshots.spec.ts --project=mobile-iphone-13-pro-max",
    "task-brief:move": "bash ./scripts/task-brief-move.sh",
    "branch-protection:apply": "bash ./scripts/apply-branch-protection.sh",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.97.0",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "*.{css,md,json,yaml,yml}": [
      "prettier --write"
    ]
  }
}
