# Mail delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Comma-separated absolute origins allowed to POST /api/contact
# Example:
# CONTACT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://freeswimming.org
CONTACT_ALLOWED_ORIGINS=

# Optional production-grade rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local-only visual testing flags for course data
# Set to 0 to disable autogenerated lessons in development.
NEXT_PUBLIC_FS_AUTOGEN_LESSONS=1
# Number of lessons to synthesize in module 1 while testing.
NEXT_PUBLIC_FS_AUTOGEN_COUNT_M1=12

# Add-to-home-screen contextual prompt kill-switch
# Set to 0 to disable automatic prompt after first completed lesson.
NEXT_PUBLIC_FS_A2HS_AUTO_PROMPT_ENABLED=1

# Supabase
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase egress guard:
# - local/test/CI should use local/example/isolated Supabase by default.
# - leave FS_ALLOW_PROD_SUPABASE=0 for normal work.
# - set FS_ALLOW_PROD_SUPABASE=1 only for an intentional production smoke/ops command.
# - set FS_PRODUCTION_SUPABASE_URL to the production origin so CI/preview cannot
#   accidentally use it while marked as isolated.
FS_SUPABASE_ENV=local
FS_ALLOW_PROD_SUPABASE=0
FS_PRODUCTION_SUPABASE_URL=

# Local-only dev auth bypass (never enable in preview/production)
# Guardrails:
# - Route is hard-disabled unless NODE_ENV=development and DEV_AUTH_BYPASS_ENABLED=1
# - Request must come from localhost/private network and include x-dev-auth-token
# - Login always uses this seeded dev account (least privilege)
DEV_AUTH_BYPASS_ENABLED=0
DEV_AUTH_BYPASS_TOKEN=
DEV_AUTH_BYPASS_EMAIL=
DEV_AUTH_BYPASS_PASSWORD=

# Optional private-mode lock (use while polishing before public launch)
# Hash format for SITE_LOCK_PASSWORD_HASH: sha256:<64-hex>
SITE_LOCK_ENABLED=0
SITE_LOCK_MODE=password
SITE_LOCK_PASSWORD_HASH=
SITE_LOCK_BYPASS_TOKEN=
# Optional Playwright private-gate test helpers (local shell/CI only)
# - automation default: set PW_SITE_LOCK_BYPASS_TOKEN (or rely on SITE_LOCK_BYPASS_TOKEN auto-wire in verify:pre-merge).
# - force password-flow coverage: set PW_SITE_LOCK_USE_PASSWORD=1 and PW_SITE_LOCK_PASSWORD.
PW_SITE_LOCK_PASSWORD=
PW_SITE_LOCK_BYPASS_TOKEN=
PW_SITE_LOCK_USE_PASSWORD=0
# Optional bootstrap admin allowlist (comma-separated emails).
# Use only for initial access bootstrap while app_metadata roles are being assigned.
ADMIN_EMAIL_ALLOWLIST=
# Optional QR redirect destination host allowlist (comma-separated hostnames or absolute URLs).
# Example: QR_REDIRECT_ALLOWED_HOSTS=freeswimming.org,www.freeswimming.org,youtu.be,youtube.com
QR_REDIRECT_ALLOWED_HOSTS=
# Optional overrides
SITE_LOCK_COOKIE_NAME=
SITE_LOCK_SESSION_MAX_AGE_SECONDS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_0_1000M_GUIDE=
STRIPE_PRICE_ID_POOLSIDE_GUIDE=
STRIPE_PRICE_ID_ANALYSIS=

# Optional server-only path override for protected 0-1000m PDF asset.
# Must be a safe repo-relative .pdf path (default: assets/guides/0-1000m-guide.pdf)
GUIDE_0_TO_1000M_PDF_ASSET_PATH=
# Optional server-only path override for protected Poolside PDF asset.
# Must be a safe repo-relative .pdf path (default: assets/guides/poolside-guide.pdf)
GUIDE_POOLSIDE_PDF_ASSET_PATH=
