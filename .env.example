# Mail delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Comma-separated absolute origins allowed to POST /api/contact
# Example:
# CONTACT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://freeswimming.org
CONTACT_ALLOWED_ORIGINS=

# Optional production-grade rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local-only visual testing flags for course data
# Set to 0 to disable autogenerated lessons in development.
NEXT_PUBLIC_FS_AUTOGEN_LESSONS=1
# Number of lessons to synthesize in module 1 while testing.
NEXT_PUBLIC_FS_AUTOGEN_COUNT_M1=12
