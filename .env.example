# Mail delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Comma-separated absolute origins allowed to POST /api/contact
# Example:
# CONTACT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,https://freeswimming.org
CONTACT_ALLOWED_ORIGINS=

# Optional production-grade rate limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local-only visual testing flags for course data
# Set to 0 to disable autogenerated lessons in development.
NEXT_PUBLIC_FS_AUTOGEN_LESSONS=1
# Number of lessons to synthesize in module 1 while testing.
NEXT_PUBLIC_FS_AUTOGEN_COUNT_M1=12

# Add-to-home-screen contextual prompt kill-switch
# Set to 0 to disable automatic prompt after first completed lesson.
NEXT_PUBLIC_FS_A2HS_AUTO_PROMPT_ENABLED=1

# Supabase
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_0_1000M_GUIDE=
STRIPE_PRICE_ID_POOLSIDE_GUIDE=
STRIPE_PRICE_ID_ANALYSIS=

# Optional server-only path override for protected 0-1000m PDF asset.
# Must be a safe repo-relative .pdf path (default: assets/guides/0-1000m-guide.pdf)
GUIDE_0_TO_1000M_PDF_ASSET_PATH=
