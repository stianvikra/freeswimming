#!/bin/sh
set -e

# Ensure npm is available when Node is managed by nvm and not preloaded in PATH.
if ! command -v npm >/dev/null 2>&1; then
  NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck disable=SC1090
    . "$NVM_DIR/nvm.sh"
    nvm use --silent --lts >/dev/null 2>&1 || nvm use --silent default >/dev/null 2>&1 || true
  fi
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "husky(pre-commit): npm not found in PATH. Install/load Node before commit." >&2
  exit 127
fi

npm exec lint-staged
